{
  "data": {
    "base_symbol": "BTCUSDT",
    "timeframe": "1h",
    "lookback_days": 3650,
    "start": null,
    "end": null,
    "squeeze": {
      "bb_period": 20,
      "bb_width_quantile": 0.1,
      "kurtosis_window": 48,
      "obv_window": 24
    },
    "label": {
      "horizon_bars": 6,
      "up_return_threshold": 0.004,
      "down_return_threshold": 0.004
    }
  },
  "env": {
    "fee_pct": 0.001,
    "slippage_pct": 0.0003
  },
  "model": {
    "hidden_sizes": [
      64,
      32
    ],
    "dropout": 0.1
  },
  "train": {
    "epochs": 30,
    "batch_size": 512,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "val_fraction": 0.2,
    "max_samples": 50000,
    "seed": 42,
    "device": "cpu",
    "outdir": "src/strategies/exper_ce_ce/reports/train"
  },
  "backtest": {
    "test_fraction": 0.3,
    "outdir": "src/strategies/exper_ce_ce/reports/backtest",
    "min_prob": 0.55,
    "min_margin": 0.05
  }
}
