{
  "env": {
    "fee_pct": 0.001,
    "slippage_pct": 0.0001,
    "position_size": 0.1,
    "stop_atr_mult": 2.0,
    "trail_atr_mult": 1.0
  },
  "model": {
    "expert_hidden": [64, 32],
    "gating_hidden": [64, 32],
    "num_experts": 5,
    "temperature": 0.7,
    "top_k": 2
  },
  "ppo": {
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_ratio": 0.2,
    "learning_rate": 0.0003,
    "entropy_coef": 0.01,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "train_iters": 4,
    "batch_size": 512
  },
  "train": {
    "episodes": 5,
    "rollout_steps": 2048,
    "device": "cpu",
    "outdir": "src/strategies/exper_corr_neg/reports/train"
  },
  "walk_forward": {
    "train_days": 720,
    "val_days": 180,
    "step_days": 90,
    "episodes": 5,
    "rollout_steps": 2048,
    "device": "cpu",
    "outdir": "src/strategies/exper_corr_neg/reports/walk_forward"
  }
}
