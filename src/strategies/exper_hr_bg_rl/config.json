{
  "data": {
    "base_symbol": "BTCUSDT",
    "timeframe": "1h",
    "lookback_days": 3650,
    "start": null,
    "end": null
  },
  "env": {
    "fee_pct": 0.001,
    "slippage_pct": 0.0003,
    "position_size": 0.001,
    "init_equity": 1000.0,
    "window_bars": 512,
    "random_start": true,
    "allow_short": true,
    "reward_scale_divisor": 10.0,
    "idle_penalty": 0.001,
    "min_hold_bars": 2
  },
  "model": {
    "hidden_sizes": [
      128,
      64
    ]
  },
  "ppo": {
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_ratio": 0.2,
    "learning_rate": 0.0003,
    "entropy_coef": 0.01,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "train_iters": 4,
    "batch_size": 2048
  },
  "train": {
    "episodes": 1000,
    "rollout_steps": 512,
    "device": "cpu",
    "outdir": "src/strategies/exper_hr_bg_rl/reports/train",
    "resume": false,
    "log_every": 10,
    "eval_every": 50,
    "seed": 42
  },
  "backtest": {
    "eval_days": 180,
    "outdir": "src/strategies/exper_hr_bg_rl/reports/backtest"
  }
}
